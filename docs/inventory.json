  "requirements": [
    {
      "id": "FR-REG-01",
      "text": "Self-registration form with Ethiopian mobile number normalization (`+2519...`)."
    },
    {
      "id": "FR-REG-02",
      "text": "Email confirmation using simulated 6-digit confirmation codes expiring in 15 minutes."
    },
    {
      "id": "FR-REG-03",
      "text": "Real-time password complexity checklist."
    },
    {
      "id": "FR-REG-04",
      "text": "Duplicate prevention on username and email addresses."
    },
    {
      "id": "FR-APP-01",
      "text": "Multi-step application wizard with draft saving."
    },
    {
      "id": "FR-APP-02",
      "text": "Capture of regional area, motivation, skills catalog, and emergency contacts."
    },
    {
      "id": "FR-APP-03",
      "text": "Manager application review queue with dossier drawers and private review notes."
    },
    {
      "id": "FR-APP-04",
      "text": "Automated acceptance letters and configurable payment window countdowns."
    },
    {
      "id": "FR-PAY-01",
      "text": "Telebirr push payment simulation terminal for accepted applicants."
    },
    {
      "id": "FR-PAY-02",
      "text": "Simulation modes for payment success, gateway delay, and user cancellation."
    },
    {
      "id": "FR-PAY-03",
      "text": "Finance exception review queue for resolving payment discrepancies."
    },
    {
      "id": "FR-PAY-04",
      "text": "Official manual cash/bank receipt generation with printable passes."
    },
    {
