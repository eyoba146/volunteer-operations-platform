      "id": "FR-ACT-02",
      "text": "Team Lead activity creation with capacity limits and project linkages."
    },
    {
      "id": "FR-ACT-03",
      "text": "Volunteer enrollment and automated waitlist promotion."
    },
    {
      "id": "FR-ACT-04",
      "text": "Live activity rosters with 4-digit check-in short code display."
    },
